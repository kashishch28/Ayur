# Copy this file to .env and fill in real values. Never commit .env itself.

# From https://dashboard.razorpay.com/app/keys — toggle "Test Mode" (top right)
# before generating these, so no real money is ever involved.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only needed if you configure a webhook in the Razorpay Dashboard
# under Settings > Webhooks, pointing at https://your-backend-url/api/webhook
RAZORPAY_WEBHOOK_SECRET=

# Lock this down to your real frontend origin once deployed, e.g.
# ALLOWED_ORIGIN=https://kashishch28.github.io
ALLOWED_ORIGIN=*

PORT=4000
